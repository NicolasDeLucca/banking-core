# Copy to .env and adjust for your machine. .env is gitignored on purpose.

DB_NAME=bankingcore
DB_USER=bankingcore
DB_PASSWORD=bankingcore
DB_PORT=5432

JWT_SECRET=replace-this-with-a-very-long-dev-secret-at-least-32-chars
JWT_EXPIRATION_SECONDS=10800

# Seeded once on startup if no user with this email exists yet
ADMIN_EMAIL=admin@bankingcore.local
ADMIN_PASSWORD=ChangeMe123!
