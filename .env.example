# Copy to .env and fill in real values for your machine. .env is gitignored
# on purpose - never commit actual secrets, not even local dev ones.

DB_NAME=bankingcore
DB_USER=bankingcore
DB_PASSWORD=<set-a-local-db-password>
DB_PORT=5432
APP_PORT=8080
# Host port for the dockerized frontend (docker compose up frontend). Defaults
# to 5173 so it lines up with CORS_ALLOWED_ORIGINS below with no extra config.
FRONTEND_PORT=5173

# Generate with: openssl rand -base64 48
JWT_SECRET=<generate-a-random-secret-at-least-32-chars-long>
JWT_EXPIRATION_SECONDS=10800

# Seeded once on startup if no user with this email exists yet
ADMIN_EMAIL=admin@bankingcore.local
ADMIN_PASSWORD=<set-a-strong-admin-password>

# Comma-separated origins allowed to call the API from a browser. Defaults to
# the frontend's local Vite dev server if unset.
CORS_ALLOWED_ORIGINS=http://localhost:5173
